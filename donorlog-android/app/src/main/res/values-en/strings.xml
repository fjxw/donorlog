    <!-- Diet Memo Activity -->
    <string name="diet_header_title">Pre-Donation Physical Preparation</string>
    <string name="diet_rule_interval_48">Strictly prohibited 48 hours prior:</string>
    <string name="diet_rule_interval_48_desc">• Alcoholic beverages of any type or strength\n• Aspirin, analgin, or analgesic-based medications (72 hours prior)</string>
    <string name="diet_rule_interval_24">Excluded 24 hours prior:</string>
    <string name="diet_rule_interval_24_desc">• Fatty, fried, spicy, or smoked food\n• Dairy products of all types (milk, kefir, cheese, butter)\n• Eggs, nuts, sunflower seeds, halva\n• Sausages, fast food, mayonnaise\n• Bananas, avocados, citrus fruits, dates</string>
    <string name="diet_breakfast_title">Morning meal on the day of donation:</string>
    <string name="diet_breakfast_desc">• Sweet black or green tea\n• Berry juice, still mineral water, dried fruit compote\n• Crackers, crispbread, oatmeal biscuits without chocolate\n• Water-cooked porridge without butter (oatmeal, buckwheat, rice)\n• Plain boiled pasta without seasonings</string>
