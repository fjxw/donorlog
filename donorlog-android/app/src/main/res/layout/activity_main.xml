<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/donor_bg_canvas">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:subtitle="@string/app_subtitle"
            app:titleTextColor="@color/donor_text_primary"
            app:subtitleTextColor="@color/donor_text_secondary"
            app:titleCentered="false"
            app:menu="@menu/menu_main" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="100dp">

                <!-- 1. YANDEX MUSIC "MY WAVE" STYLE HERO BANNER -->
                <FrameLayout
                    android:id="@+id/layoutHeroWave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_wave_gradient"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <!-- Glowing Animated Droplet Pulse -->
                        <ImageView
                            android:id="@+id/ivHeroPulse"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:src="@drawable/ic_blood_pulse_spark" />

                        <!-- Main Countdown Title -->
                        <TextView
                            android:id="@+id/tvIntervalBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_badge_green"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp"
                            android:text="Допущен к сдаче"
                            android:textColor="@color/status_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvIntervalDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/status_ready_desc"
                            android:textColor="@color/donor_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Glass Pill: Donor Quick Info -->
                        <LinearLayout
                            android:id="@+id/cardDonorProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_glass_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <TextView
                                android:id="@+id/tvBloodGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_blood_group"
                                android:textColor="@color/donor_ruby_glow"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_marginHorizontal="10dp"
                                android:background="@drawable/bg_avatar_circle" />

                            <TextView
                                android:id="@+id/tvDonorName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/default_donor_name"
                                android:textColor="@color/donor_text_primary"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_marginHorizontal="10dp"
                                android:background="@drawable/bg_avatar_circle" />

                            <TextView
                                android:id="@+id/tvDonorRegionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="г. Москва"
                                android:textColor="@color/donor_amber_warm"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Moscow Honored Progress Mini-Pill -->
                        <LinearLayout
                            android:id="@+id/layoutHonoredMoscowBanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHonoredMoscowShort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="Почетный донор Москвы: 3 из 20 (15%)"
                                android:textColor="#FBBF24"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/pbHonoredMoscowProgress"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:progress="15"
                                app:indicatorColor="#F59E0B"
                                app:trackColor="#33F59E0B"
                                app:trackCornerRadius="3dp" />
                        </LinearLayout>

                        <!-- Federal Honored Progress -->
                        <TextView
                            android:id="@+id/tvHonoredShort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:text="Почетный донор России: 3 из 40 (8%)"
                            android:textColor="@color/donor_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/pbHonoredProgress"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:progress="8"
                            app:indicatorColor="@color/donor_ruby_mid"
                            app:trackColor="#33E11D48"
                            app:trackCornerRadius="3dp" />

                    </LinearLayout>
                </FrameLayout>

                <!-- 2. "MY VIBE" / SERVICES HORIZONTAL SNAP CAROUSEL -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:text="Сервисы и навигация"
                    android:textColor="@color/donor_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Card 1: Traffic Light (Ruby Gradient) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNavTraffic"
                            android:layout_width="160dp"
                            android:layout_height="124dp"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_vibe_card_ruby"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivTrafficIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_hospital"
                                    app:tint="#FFFFFF" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:text="Светофор\nкрови"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 2: Honored Donor (Purple Gradient) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNavRoadmap"
                            android:layout_width="160dp"
                            android:layout_height="124dp"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_vibe_card_purple"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivHonorIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_award"
                                    app:tint="#FFFFFF" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:text="Почетный\nдонор"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 3: Analytics (Emerald Gradient) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNavAnalytics"
                            android:layout_width="160dp"
                            android:layout_height="124dp"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_vibe_card_emerald"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivAnalyticsIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_heart"
                                    app:tint="#FFFFFF" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:text="Аналитика\nздоровья"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 4: Diet Memo (Amber Gradient) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNavDiet"
                            android:layout_width="160dp"
                            android:layout_height="124dp"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_vibe_card_amber"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivDietIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_restaurant"
                                    app:tint="#FFFFFF" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:text="Памятка\nдиеты"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Card 5: Contraindications -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardNavContra"
                            android:layout_width="160dp"
                            android:layout_height="124dp"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_vibe_card_purple"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivContraIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_shield"
                                    app:tint="#FFFFFF" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentBottom="true"
                                    android:text="Реестр\nотводов"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 3. APPLE HEALTH STYLE BENTO STATS GRID -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="Показатели донора"
                    android:textColor="@color/donor_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="horizontal">

                    <!-- Stat 1: Donations -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bento_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatDonationsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/donor_ruby_glow"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stat_donations"
                            android:textColor="@color/donor_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Stat 2: Volume -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bento_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatVolumeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.5 л"
                            android:textColor="@color/donor_amber_warm"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stat_volume"
                            android:textColor="@color/donor_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Stat 3: Lives Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_bento_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatLivesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="@color/donor_emerald_vital"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stat_lives"
                            android:textColor="@color/donor_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 4. ACHIEVEMENTS RIBBON (Google Play Style) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Награды и достижения"
                        android:textColor="@color/donor_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTierBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_yellow"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Ступень: Опытный"
                        android:textColor="@color/donor_amber_warm"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Badge 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadge1"
                            android:layout_width="@dimen/badge_card_width"
                            android:layout_height="@dimen/badge_card_height"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#161B26"
                            app:strokeWidth="1dp"
                            app:strokeColor="#283144">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_award"
                                    app:tint="@color/donor_emerald_vital" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Первый шаг"
                                    android:textColor="@color/donor_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Получено"
                                    android:textColor="@color/donor_emerald_vital"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Badge 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadge2"
                            android:layout_width="@dimen/badge_card_width"
                            android:layout_height="@dimen/badge_card_height"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#161B26"
                            app:strokeWidth="1dp"
                            app:strokeColor="#283144">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/donor_emerald_vital" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Регулярный"
                                    android:textColor="@color/donor_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="3 из 3 в год"
                                    android:textColor="@color/donor_emerald_vital"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Badge 3 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadge3"
                            android:layout_width="@dimen/badge_card_width"
                            android:layout_height="@dimen/badge_card_height"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#161B26"
                            app:strokeWidth="1dp"
                            app:strokeColor="#283144">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_heart"
                                    app:tint="@color/donor_ruby_glow" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Спасатель"
                                    android:textColor="@color/donor_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="7 жизней"
                                    android:textColor="@color/donor_ruby_glow"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Badge 4 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadge4"
                            android:layout_width="@dimen/badge_card_width"
                            android:layout_height="@dimen/badge_card_height"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#161B26"
                            app:strokeWidth="1dp"
                            app:strokeColor="#283144">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_shield"
                                    app:tint="@color/donor_amber_warm" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Марафонец"
                                    android:textColor="@color/donor_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="3 из 10"
                                    android:textColor="@color/donor_amber_warm"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Badge 5 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBadge5"
                            android:layout_width="@dimen/badge_card_width"
                            android:layout_height="@dimen/badge_card_height"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp"
                            app:cardBackgroundColor="#161B26"
                            app:strokeWidth="1dp"
                            app:strokeColor="#283144">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/donor_purple_vibe" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Почетный"
                                    android:textColor="@color/donor_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="15% выполнено"
                                    android:textColor="@color/donor_purple_vibe"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 5. RECENT DONATIONS FEED -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_donations_header"
                        android:textColor="@color/donor_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDonationsCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_red"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="3"
                        android:textColor="@color/donor_ruby_glow"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyDonations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="24dp"
                    android:gravity="center"
                    android:text="@string/empty_donations_placeholder"
                    android:textColor="@color/donor_text_secondary"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDonations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_donation_card" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FLOATING ACTION PILL (Modern Material You FAB) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddDonation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/action_add_donation"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/donor_ruby_mid"
        app:icon="@drawable/ic_plus"
        app:iconTint="#FFFFFF"
        app:cornerRadius="28dp"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
