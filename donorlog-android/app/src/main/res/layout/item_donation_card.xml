<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/donation_card_margin_horizontal"
    android:layout_marginVertical="@dimen/donation_card_margin_vertical"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivComponentIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/label_component_type"
                android:src="@drawable/ic_blood_drop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvComponentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Цельная кровь"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDonationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26.08.2026"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450 мл"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Центр крови им. О.К. Гаврилова"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvHealthMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hb: 142 г/л • АД: 120/80 • ЧСС: 72"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
