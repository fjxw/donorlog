<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row (Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_blood_drop" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="DonorLog • Статус донора"
            android:textColor="#201A1A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Допущен к сдаче"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Readiness & Interval Full-Width Banner -->
    <TextView
        android:id="@+id/tvWidgetIntervalText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_green"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Интервал 60 дней выдержан • Допуск открыт"
        android:textColor="@color/status_green"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Donor Identity Line (Full Width) -->
    <TextView
        android:id="@+id/tvWidgetDonorInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ряховский Алексей Александрович • A(II) Rh+ • г. Москва"
        android:textColor="#201A1A"
        android:textSize="12sp" />

    <!-- 3 Metrics Full-Width Unified Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFF5F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvWidgetStatDonations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="3 донации"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="#857373" />

        <TextView
            android:id="@+id/tvWidgetStatVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1.5 л сдано"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="#857373" />

        <TextView
            android:id="@+id/tvWidgetStatLives"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="7 жизней"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Honored Donor Progress (Full Width) -->
    <TextView
        android:id="@+id/tvWidgetHonored"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Почетный донор: 2 из 20 (10%)"
        android:textColor="#201A1A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pbWidgetHonored"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="10"
        android:progressTint="#B3261E" />

    <!-- Action Prompt (Full Width) -->
    <TextView
        android:id="@+id/tvWidgetAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:text="Открыть дневник донора >"
        android:textColor="#B3261E"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
