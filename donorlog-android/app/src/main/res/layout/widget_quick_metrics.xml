<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetMetricsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row (Full Width) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_heart" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="DonorLog • Биомаркеры"
            android:textColor="#201A1A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetMetricsNormBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="В норме"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle (Full Width) -->
    <TextView
        android:id="@+id/tvWidgetMetricsDonor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Алексей Ряховский • Последняя донация: 27.08.2026"
        android:textColor="#534343"
        android:textSize="11sp" />

    <!-- Metrics Row 1: Hemoglobin (Full Width Banner) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFF5F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Гемоглобин (Hb):"
            android:textColor="#201A1A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetHbValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="140.0 г/л"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Metrics Row 2: Blood Pressure & Pulse (Full Width Banner) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#FFF5F5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="АД и пульс:"
            android:textColor="#201A1A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetBpValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120/80 мм рт. ст. • 72 уд/мин"
            android:textColor="#B3261E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer Action (Full Width) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="+ Внести новую запись >"
        android:textColor="#B3261E"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
