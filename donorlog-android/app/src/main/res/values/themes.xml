<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (unified modern dark canvas inspired by Yandex Music & Google Play) -->
    <style name="Theme.DonorLog" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/donor_ruby_mid</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/donor_ruby_start</item>
        <item name="colorOnPrimaryContainer">#FFE4E8</item>

        <item name="colorSecondary">@color/donor_amber_warm</item>
        <item name="colorOnSecondary">#0E1118</item>
        <item name="colorSecondaryContainer">#1E2433</item>
        <item name="colorOnSecondaryContainer">@color/donor_text_primary</item>

        <item name="android:colorBackground">@color/donor_bg_canvas</item>
        <item name="colorSurface">@color/donor_surface_card</item>
        <item name="colorOnSurface">@color/donor_text_primary</item>
        <item name="colorOutline">@color/donor_stroke_subtle</item>

        <item name="android:textColorPrimary">@color/donor_text_primary</item>
        <item name="android:textColorSecondary">@color/donor_text_secondary</item>

        <!-- Status & Navigation Bar Appearance -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/donor_bg_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
